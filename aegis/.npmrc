# @automata-network/on-chain-pccs@1.1.1 declares a strict peer dependency on
# solady@0.0.160, while this project (and the DCAP compile path it feeds) uses
# solady ^0.1.26. The two are not API-compatible as declared, but the resolved
# tree is the one the recorded results were produced with, and npm's default
# ERESOLVE behaviour makes a fresh clone fail outright.
#
# Pinning the resolution here keeps `npm install` / `npm ci` working verbatim
# from a clean clone, which is what the reproduction table assumes.
legacy-peer-deps=true
