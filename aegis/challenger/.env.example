# challenger 独立配置（本目录拷到队友机器后：cp .env.example .env 并填写）
CHALLENGER_PK=

# Monad testnet（默认官方 RPC + Ankr 备用，一般不用改）
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# 链上合约（与 proposer 侧一致；Phase 2 v2 部署）
REGISTRY=0x4622D041696942dC873a8A5E54f1e1ca9669c90B
VALIDATION=0x8b96a09eb50409FE4c402cB9Bb9D1Ef79bbe0cEa
VAULT=0xe6E24BB72a4a327b7A7E7aA025A04eBc5a6533D7

# proposer 侧 orchestrator 地址（拉决策原文用；同网段直连或隧道）
ORCH_URL=http://localhost:8787

AGENT_ID=1
POLL_MS=4000
# 拒绝也上链留证（demo 时改 true）
RECORD_REJECT=false
