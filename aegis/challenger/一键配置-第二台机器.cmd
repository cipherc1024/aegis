@echo off
cd /d "%~dp0"
powershell -NoExit -ExecutionPolicy Bypass -NoProfile -Command "& { $src=(Get-Location).Path; Write-Host '=== Aegis challenger one-click setup (SECOND machine) ===' -ForegroundColor Cyan; Write-Host ('dir: '+$src); if (-not (Get-Command node -ErrorAction SilentlyContinue)) { Write-Host '[ERROR] node not found: install Node.js LTS (keep Add to PATH), then re-run.' -ForegroundColor Red; Start-Process 'https://nodejs.org/en/download' } else { $bad = (($src[0] -ne 'C') -or ($src -match 'wechat|xwechat|OneDrive|Temp')); if ($bad) { $dst = Join-Path $env:USERPROFILE 'aegis-challenger'; Write-Host ('Non-C/WeChat folder detected. Working copy: '+$dst) -ForegroundColor Yellow; if (-not (Test-Path (Join-Path $dst 'setup-second-host.mjs'))) { if (Test-Path $dst) { Remove-Item $dst -Recurse -Force }; Copy-Item -LiteralPath $src -Destination $dst -Recurse -Force }; Set-Location -LiteralPath $dst; Write-Host ('now in: '+(Get-Location)) -ForegroundColor Yellow }; node .\setup-second-host.mjs }; Write-Host ''; Write-Host '--- window stays open (-NoExit). ---' -ForegroundColor Yellow }"
