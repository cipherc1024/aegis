# 复制为 .env 并填写（.env 已被 .gitignore 忽略，切勿提交）
# ---- Monad testnet ----
MONAD_TESTNET_PK=
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143

# ---- 链上合约（v5 部署，见 aegis/README.md 部署地址表；不填时代码用同一组默认值）----
REGISTRY=0x4622D041696942dC873a8A5E54f1e1ca9669c90B
VALIDATION=0x8b96a09eb50409FE4c402cB9Bb9D1Ef79bbe0cEa
QUORUM_VAULT=0x3aBbb284760dce5643A8a5D1bA2bb9A58C2b89De

# ---- quorum 授权 challenger（AegisVaultQuorum.setTrustedValidator）----
# ValidationRegistry 是无许可注册表：任何人可自称 validator 并自己回 100。
# 合约只认 owner 白名单里的地址，故部署后必须授权，否则 executeTrade 永远 revert（fail-closed）。
# 自 v5 起金库含 registry 可换（setReceiptRegistry）+ 余额检查；重部署时 scripts/deploy-v5.mjs 会自动授权此地址。
# ⚠️ 此值**必须等于 `CHALLENGER_PK` 派生出的地址**——deploy-v5.mjs 会做该一致性断言，
#    不一致直接拒绝部署（否则会把错误地址授权进白名单，真 challenger 不被信任 → executeTrade 全 revert）。
# CHALLENGER_ADDR=0x16e619c3d6625f4d6F583791A4C2351D65508a2c

# ---- LLM（OpenAI 兼容）----
# ⚠️ 本项目的 LLM 跑在 proposer 侧（orchestrator），**不需要**放进 TEE：
#    见 A会论文路线图.md §5「信任边界」——DLA 只保证 δ 被正确求值，不要求 LLM 在 TEE 内。
#    默认主用官方 DeepSeek API（全球可达）；若换内网/校园端点，让 orchestrator 与其同网段运行即可。
#    （若模型仅限内网/校园网，challenger 在队友机器上跨网段时，需给它的 LLM 另配可达端点，
#      或让 challenger 只跑 4 层确定性重推导、把 L5 交叉模型层留空——见 MODEL_CHALLENGE）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# challenger 侧可选 L5 跨家族模型（`MODEL_CHALLENGE=true` 时生效；须与 proposer 不同家族）
# 例：proposer 用 DeepSeek，challenger 用 Qwen 本地 7B / 另一家 API；留空 = L5 关闭
LLM_CHALLENGER_MODEL=

# ---- 策略（必须与 challenger/challenger-policy.json 同口径；改后跑 challenger/policy-attest.mjs）----
# WHITELIST=0x...            # 白名单目标地址（逗号分隔）
# PER_TX_LIMIT=50000000000000000        # 0.05 MON
# DAILY_LIMIT=500000000000000000        # 0.5 MON
# BLOCKLIST=evil.com,attacker,drain,ignore previous
# TRUSTED_CMD=buy USDC 0.01
# AGENT_ID=1

# ---- orchestrator CORS 白名单（可选）----
# 本进程持有 proposer 私钥且 /api/agent/command 可写（可真实上链），故默认只放行本地
# dashboard；dashboard 生产路径走 Next 同源 rewrite（不经 CORS），此项主要服务本地 dev。
# 逗号分隔；留空 = 用默认值 http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- orchestrator 写端点加固（两个独立闸门，取与）----
# 写端点 = /api/agent/command、/api/admin/*、/api/agents、/api/objective/draft（会动钱或改链上权限）。
# 只读端点不设限（dashboard 需要无凭据也能渲染真实读数）。
#
# 闸门①（谁能调用）：ORCH_API_TOKEN 非空 → 写端点要求请求头 X-API-Token 匹配，否则 401 且不发任何交易。
#        留空 → **全部写端点强制降级为预览**（只读），无论闸门②如何。
# 闸门②（这台机器是否具备发真钱的条件）：ORCH_ENABLE_EXECUTE=1 才允许 execute/confirm 真正广播。
#        默认（未设）→ 收据与 transcript 仍会上链，但 executeTrade 不广播，
#        回包 execution.status="execute_disabled" 并附原因（不是静默忽略）。
# 任一不满足都必须降级为预览（fail-closed：宁可拒绝，不可放行）。
#
# 本地演示要真实上链时，两个都要设；仅看预览则一个都不设。
# ORCH_API_TOKEN=换成你自己的随机串
# ORCH_ENABLE_EXECUTE=1

# ---- orchestrator 监听地址（可选）----
# 默认 127.0.0.1（只回环）。本进程持有 proposer 私钥且写端点可真实花 gas，
# 绑 0.0.0.0 等于把「花你的钱」暴露给同网段任何主机。确需远程访问才显式放开，
# 且必须同时设 ORCH_API_TOKEN（否则写端点仍是预览，但读面与内网地址会暴露）。
# ORCH_HOST=0.0.0.0

# ---- dashboard 侧同步带 token（可选，仅本机运营面板用）----
# 与 ORCH_API_TOKEN 同值。⚠️ NEXT_PUBLIC_* 会**内联进前端产物**——只在
# 「dashboard 与 orchestrator 同属一个部署者、且产物不公开分发」时才设。
# 要公开托管 dashboard 产物时不要设它，改用服务端代理注入 header。
# NEXT_PUBLIC_ORCH_API_TOKEN=换成你自己的随机串

# ---- Phala Cloud（可选）----
PHALA_CLOUD_API_KEY=

# ---- Phala CVM quote 服务（Phase 2；绑定 digest 的真 TDX quote）----
QUOTE_URL=

# ---- SOA-lite：签署目标（draft-then-sign 的「用户」角色）----
# 用户私钥只用于对目标 canonical JSON 做 EIP-191 签名，不需要资金、不需要上链。
# ⚠️ 真实部署中该私钥只应存在于用户自己的设备上；仓库内的 .env 仅供本地 demo 复现。
#
# 下面这个值是**公开的测试密钥**（artifact 复现专用）——它不进任何真实部署，
# 不含资金、不上链，仅用于让评审在干净克隆里跑通 ARTIFACT.md 第 6 行
# `node scripts/soa-demo.mjs`（4/4 场景）。对应地址见注释末。
# 换一个自己的：node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
SOA_USER_PK=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# ↑ 对应地址 0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# 目标容差与有效期默认值（scripts/soa-demo.mjs、POST /api/objective/draft 用）
# SOA_TOL_WEI=1000000000000000
# SOA_DEADLINE_SEC=3600
